# Set these as Render environment variables (not in Git).
DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_PORT/YOUR_DATABASE?sslMode=REQUIRED
DB_USERNAME=YOUR_AIVEN_USERNAME
DB_PASSWORD=REPLACE_WITH_AIVEN_PASSWORD
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
TRAINER_SEED_PASSWORD=OPTIONAL_STRONG_TRAINER_PASSWORD
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=1
